# ──────────────────────────────────────────────
# SafeBoard — Windows 로컬 서버용 환경변수 템플릿
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우세요
# ──────────────────────────────────────────────

# [필수] PostgreSQL 접속 주소
# 형식: postgresql://유저명:비밀번호@localhost:5432/데이터베이스명
DATABASE_URL=postgresql://postgres:여기에비밀번호@localhost:5432/safetyboard

# [필수] 세션 암호화 키 — 영문+숫자 32자 이상 아무 문자열
SESSION_SECRET=여기에-랜덤-문자열-최소32자이상-입력하세요

# [선택] 서버 포트 (기본값 5000, 변경 원하면 수정)
PORT=5000

# ──────────────────────────────────────────────
# AI 기능 (GPT 채팅봇, PDF 자동추출 등)
# OpenAI 계정에서 발급: https://platform.openai.com/api-keys
# ──────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=sk-여기에-OpenAI-API-키-입력
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Claude AI (현재 일부 기능 사용)
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-여기에-Anthropic-키-입력

# ──────────────────────────────────────────────
# 이메일 발송 (점검 결과 메일, 자동 리포트 등)
# Gmail 앱 비밀번호 발급: Google 계정 → 보안 → 앱 비밀번호
# ──────────────────────────────────────────────
GMAIL_SENDER=보내는계정@gmail.com
GMAIL_APP_PASSWORD=앱비밀번호-16자리
GMAIL_RECIPIENTS=받는사람1@example.com,받는사람2@example.com

# 이메일 발송 대안 서비스 (Resend — https://resend.com)
RESEND_API_KEY=re_여기에-Resend-키

# ──────────────────────────────────────────────
# 기상청 API (폭염 자동 수집)
# https://www.data.go.kr 에서 발급
# ──────────────────────────────────────────────
KMA_API_KEY=여기에-기상청-API-키

# 안전보건공단 API
KOSHA_SERVICE_KEY=여기에-KOSHA-서비스-키

# ──────────────────────────────────────────────
# 파일 저장 경로 (Windows에서는 아래 두 줄 그대로 두세요)
# 파일은 프로젝트 폴더 안 uploads/ 에 로컬로 저장됩니다
# ──────────────────────────────────────────────
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ──────────────────────────────────────────────
# 아래 항목은 Windows에서 사용 안 함 — 비워두세요
# ──────────────────────────────────────────────
REPLIT_DEV_DOMAIN=
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
MOSAIC_USERNAME=
MOSAIC_PASSWORD=
